# App-only distribution. Keep local research inputs and tooling on disk, not Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/app.py
!/__init__.py
!/webinar/
/webinar/*
!/webinar/*.py
/webinar/physical_view.py
/webinar/temporal_results.py
/webinar/fair_results.py
/webinar/pulse_results.py
!/lca_model/
/lca_model/*
!/lca_model/__init__.py
!/lca_model/contracts.py
!/lca_model/scenario_table.py
!/lca_model/results.py
!/assets/
/assets/*
!/assets/*.css
!/assets/*.js
!/assets/favicon.ico
!/assets/psi-mark.svg
!/assets/premise-logo.png
!/assets/pik-logo.png
!/assets/enc-europe.svg
!/assets/ssp2-global-trends.svg
!/assets/paper-figure-1.jpg
!/assets/paper-figure-2.jpg
!/data/
/data/*
!/data/public/
/data/public/*
!/data/public/bau_detail_2025.json
!/data/public/capture_details_2025.json
!/data/public/model_contract.json
!/data/public/source_manifest.json
!/data/public/heat_supply.json
!/data/public/component_lifetimes.json
!/data/public/uptake_profiles.json
!/data/public/uptake_profiles.sha256
!/data/assumptions/
/data/assumptions/*
!/data/assumptions/methanol_to_jet.json
!/data/processed/
/data/processed/*
!/data/processed/scenario_sector_mixes.csv
!/data/processed/sector_shares_six_years.json
!/data/processed/sector_shares_six_years.sha256
!/data/processed/gas_supply_shares.json
!/data/processed/gas_supply_shares.sha256
!/data/runtime/
/data/runtime/*
!/data/runtime/*.json
!/data/runtime/*.json.gz
!/data/runtime/*.sha256
/data/runtime/system_flows_2025.json
/data/runtime/direct_utilities_2025.json
__pycache__/
*.py[cod]
